# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ab_consultancy_db

# JWT & Security Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_secure_cookie_signing_secret

# Initial Super Admin Seed Credentials (used only by seed script)
SUPERADMIN_NAME="Anilkumarsingh Bhadauria"
SUPERADMIN_EMAIL="abtaxway@gmail.com"
SUPERADMIN_PASSWORD="ChangeMe@2026#Secure"

# CORS Configuration (comma separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://abconsultancy.vercel.app

# Uploads Configuration
UPLOAD_STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
